{
  "app": {
    "name": "gatepup",
    "logLevel": "info"
  },
  "listeners": [
    {
      "name": "public-http",
      "bind": "0.0.0.0:80",
      "protocol": "http",
      "routes": [
        {
          "name": "frontend",
          "match": {
            "host": "example.com",
            "pathPrefix": "/"
          },
          "upstream": "frontend"
        },
        {
          "name": "api",
          "match": {
            "host": "api.example.com",
            "pathPrefix": "/"
          },
          "upstream": "api"
        }
      ]
    }
  ],
  "upstreams": [
    {
      "name": "frontend",
      "loadBalancing": "round_robin",
      "targets": [
        {
          "url": "http://frontend:3000",
          "weight": 1
        }
      ],
      "healthCheck": {
        "enabled": true,
        "path": "/",
        "intervalSeconds": 10,
        "timeoutMs": 1000,
        "healthyThreshold": 2,
        "unhealthyThreshold": 3
      }
    },
    {
      "name": "api",
      "loadBalancing": "round_robin",
      "targets": [
        {
          "url": "http://api-1:4000",
          "weight": 1
        },
        {
          "url": "http://api-2:4000",
          "weight": 1
        }
      ],
      "healthCheck": {
        "enabled": true,
        "path": "/health",
        "intervalSeconds": 10,
        "timeoutMs": 1000,
        "healthyThreshold": 2,
        "unhealthyThreshold": 3
      },
      "retries": {
        "enabled": true,
        "attempts": 2,
        "methods": ["GET", "HEAD", "OPTIONS"],
        "retryOn": ["connect_error", "upstream_5xx"]
      }
    }
  ],
  "timeouts": {
    "connectTimeoutMs": 5000,
    "requestTimeoutMs": 30000
  },
  "admin": {
    "enabled": true,
    "bind": "127.0.0.1:8080"
  },
  "metrics": {
    "enabled": true,
    "path": "/metrics"
  }
}
