{
  "app": { "name": "bench", "logLevel": "warn" },
  "listeners": [
    {
      "name": "l",
      "bind": "127.0.0.1:8088",
      "protocol": "http",
      "routes": [
        { "name": "all", "match": { "pathPrefix": "/" }, "upstream": "u" }
      ]
    }
  ],
  "upstreams": [
    {
      "name": "u",
      "loadBalancing": "round_robin",
      "targets": [{ "url": "http://127.0.0.1:9000" }]
    }
  ],
  "admin": { "enabled": false, "bind": "127.0.0.1:8080" },
  "metrics": { "enabled": false, "path": "/metrics" }
}
